{
  "name": "njangitrust",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "services:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/services.ps1 start",
    "services:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/services.ps1 stop",
    "services:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/services.ps1 status",
    "dev:api": "pnpm --filter @njangi/api dev",
    "dev:mobile": "pnpm --filter @njangi/mobile start",
    "dev:web": "pnpm --filter @njangi/mobile web",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:rules": "pnpm --filter @njangi/rules test",
    "db:migrate": "pnpm --filter @njangi/api db:migrate",
    "db:seed": "pnpm --filter @njangi/api db:seed",
    "agent:eval": "pnpm --filter @njangi/agent-eval eval",
    "verify-ledger": "pnpm --filter @njangi/verify-ledger verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
