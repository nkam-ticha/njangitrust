# Copy to .env locally. Put the production values in Vercel Project Settings,
# never in Git. Supabase supplies the PostgreSQL connection used by Prisma.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=1

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1
# Use a direct Supabase connection for migrations, backups, and restore operations.
MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
PRISMA_MIGRATE_URL=
# Legacy long-running deployment only; not used by the Vercel serverless functions.
REDIS_URL=

JWT_SECRET=generate-a-unique-secret-at-least-32-characters
JWT_REFRESH_SECRET=generate-a-different-secret-at-least-32-characters
HASH_SECRET=generate-a-unique-secret-at-least-32-characters
CRON_SECRET=generate-a-unique-secret-at-least-32-characters
DISBURSEMENT_REFUND_SECRET=generate-a-separate-unique-secret-at-least-32-characters

STORAGE_DRIVER=supabase
STORAGE_SIGNING_SECRET=generate-a-unique-secret-at-least-32-characters
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
SUPABASE_JWT_SECRET=project-jwt-secret-from-supabase-api-settings
SUPABASE_STORAGE_BUCKET=njangi-private
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

PAYMENT_PROVIDER=mock
# Fees: fixed FCFA plus an optional per-thousand part, for example CamPay's 2 % and 1.5 %:
# FEE_SCHEDULE={"collection":0,"disbursement":0,"collectionPermille":20,"disbursementPermille":15}
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Permanent access token of the CamPay app (used instead of username and password when set).
CAMPAY_ACCESS_TOKEN=
# Webhook key of the CamPay app: checks the signature of its callbacks.
CAMPAY_WEBHOOK_KEY=
CAMPAY_ENV=PROD
FEE_SCHEDULE={"collection":100,"disbursement":500}

EXPO_ACCESS_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fallback providers: used in this order when the one before is rate-limited or down (docs/AGENT.md).
# Each needs its key and its model id. A provider with either one missing is left out.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_PROVIDER_ORDER=openrouter,groq,google
# More accounts for the same models, comma separated. Batch 1 is the first key of each provider,
# batch 2 the second key of each, and so on: a later batch is asked only when the earlier ones stop.
OPENROUTER_API_KEYS=
GROQ_API_KEYS=
GOOGLE_AI_API_KEYS=
# Groq's free tier takes about 7000 input tokens a minute: larger requests are cut to this size.
GROQ_MAX_INPUT_TOKENS=6000
# on: a short first call picks the tool categories (docs/AGENT.md). Off unless the model needs it.
AGENT_TOOL_ROUTING=off

APP_TIMEZONE=Africa/Douala
PUBLIC_BASE_URL=https://api.example.com
PUBLIC_APP_URL=https://app.example.com
WEB_ORIGINS=https://app.example.com
# Web refresh cookie: strict when the web app and the API share a site, none when they do not.
# COOKIE_SAMESITE=strict
