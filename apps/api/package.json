{
  "name": "@njangi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:status": "prisma migrate status",
    "db:reset:test": "tsx scripts/reset-test-db.ts",
    "db:seed": "tsx --env-file=.env prisma/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@njangi/rules": "workspace:*",
    "@njangi/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "bullmq": "6.5.3",
    "expo-server-sdk": "8.0.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "openai": "7.47.0",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "rate-limiter-flexible": "11.2.3",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1"
  }
}
