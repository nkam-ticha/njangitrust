        "mustMatch": ["(?i)(pr[ée]pare|payer|paiement)"]
      },
      "script": [
        [
          { "tools": [{ "name": "get_my_overview", "args": {} }] },
          {
            "reply": "Tu dois {{amount:due}} pour le tour 4, avant {{date:deadline}}. Je prépare le paiement ?"
